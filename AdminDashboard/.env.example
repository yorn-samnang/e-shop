NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000
# Server-to-server backend URL. Docker Compose sets this to http://backend:8000.
# Leave blank for local Next.js development outside Docker.
BACKEND_INTERNAL_URL=
# Created automatically when a Vercel Blob store is connected to this project.
# Keep this server-only token secret; never prefix it with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here
