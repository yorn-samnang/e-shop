SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# Production (Render + Supabase): copy the Session pooler URI from Supabase's
# Connect dialog. DATABASE_URL takes precedence over the DB_* values below.
# DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres


CORS_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000 http://localhost:3001
# Must match Ecommerce NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Variables needed by docker-compose for DB service
POSTGRES_PASSWORD=your_password_here
POSTGRES_USER=your_db_user_here
POSTGRES_DB=ecommerce_db
