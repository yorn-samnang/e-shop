NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000
# Create a Google OAuth client with application type "Web application".
# Add http://localhost:3001 and your production storefront origin under
# Authorized JavaScript origins in Google Cloud Console. Use the same client ID
# in Backend/.env as GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Connect the same public Vercel Blob store used by the admin project.
# Keep this server-only token secret; never prefix it with NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here
